# ─────────────────────────────────────────────────────────────────────────────
# Esocity Intelligence — environment variables
#
# Copy to .env.local for local development:   cp .env.example .env.local
# NEVER commit real values. This file contains placeholders only.
# Every variable is optional: with nothing set the app runs in demo mode on
# synthetic data with in-memory storage (the default Vercel first deploy).
# All values are validated at runtime by lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Public name shown in the UI (inlined into the browser bundle).
NEXT_PUBLIC_APP_NAME=Esocity
# Canonical site URL for metadata (OpenGraph, sitemap). Vercel URLs are used when unset.
NEXT_PUBLIC_APP_URL=

# Demo mode: shared "Demo Analyst" identity, synthetic data, no sign-in.
# Production mode (false) requires DATABASE_URL, AUTH_SECRET and an auth provider.
DEMO_MODE=true
# Pin the demo clock to a date (YYYY-MM-DD) for reproducible screenshots/tests.
DEMO_AS_OF=

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# ── PostgreSQL (optional in demo mode) ───────────────────────────────────────
# Enables durable paper accounts, persisted backtests and the append-only audit trail.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# For the local docker-compose database see docs/ARCHITECTURE.md → Local development.
DATABASE_URL=
DATABASE_POOL_MAX=5

# ── Redis / Upstash (optional) ───────────────────────────────────────────────
# Shared cache and rate limits across serverless instances. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Python ML service (optional) ─────────────────────────────────────────────
# The app falls back to its TypeScript engines when unset or unreachable.
ML_API_URL=
# Shared secret (≥16 chars); must equal ML_API_KEY configured on the service.
ML_API_KEY=
ML_API_TIMEOUT_MS=2500

# ── Authentication (production mode) ─────────────────────────────────────────
# ≥32 random characters, e.g. `openssl rand -base64 32`. See docs/SECURITY.md.
AUTH_SECRET=

# ── Data providers ───────────────────────────────────────────────────────────
# "demo" = synthetic data, no keys, no database. Licensed providers ("polygon",
# "api-football") are ingested into PostgreSQL on a schedule and served from it,
# so they require DATABASE_URL. See docs/DATA_PIPELINE.md.
# markets: demo | polygon | (planned: twelvedata | alphavantage | fmp | enterprise)
MARKET_DATA_PROVIDER=demo
# sports: demo | api-football | (planned: sportmonks | opta)
SPORTS_DATA_PROVIDER=demo

# Polygon.io (Massive) — split-adjusted daily bars. The key is sent as a bearer
# header, never in URLs. Free plans allow 5 requests/minute and ~2 years of history.
POLYGON_API_KEY=
# Optional: override the API origin (HTTPS; plain HTTP only for localhost mocks).
POLYGON_BASE_URL=
POLYGON_REQUESTS_PER_MINUTE=5
# Universe (1–50 US-listed symbols, comma-separated) and first-run history.
MARKET_DATA_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY
MARKET_DATA_BACKFILL_DAYS=730

# API-Football (api-sports.io) — fixtures, results, xG, availability.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=
# League ids (1–5): 39 = Premier League, 140 = La Liga, 135 = Serie A, 78 = Bundesliga.
API_FOOTBALL_LEAGUES=39
# Optional: pin a season (e.g. 2024) when your plan does not cover the current one.
API_FOOTBALL_SEASON=
# The free plan allows 100 requests/day and 10/minute.
API_FOOTBALL_MAX_REQUESTS_PER_RUN=30
API_FOOTBALL_REQUESTS_PER_MINUTE=10

# ── Scheduled ingestion ──────────────────────────────────────────────────────
# Vercel Cron (vercel.json) sends "Authorization: Bearer <CRON_SECRET>".
# ≥16 random characters, e.g. `openssl rand -hex 32`. Unset = scheduled ingestion off.
CRON_SECRET=
# Planned provider keys (not read yet): TWELVE_DATA_API_KEY, ALPHA_VANTAGE_API_KEY,
# FMP_API_KEY, SPORTMONKS_API_TOKEN

# ── Broker ───────────────────────────────────────────────────────────────────
# Only "paper" is permitted. Live adapters are refused at runtime by design.
BROKER_ADAPTER=paper

# ── Build ────────────────────────────────────────────────────────────────────
# Set to "standalone" for container builds (the Dockerfile does this).
NEXT_OUTPUT=
