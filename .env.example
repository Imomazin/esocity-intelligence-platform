# ─────────────────────────────────────────────────────────────────────────────
# Esocity Intelligence — environment variables
#
# Copy to .env.local for local development:   cp .env.example .env.local
# NEVER commit real values. This file contains placeholders only.
# Every variable is optional: with nothing set the app runs in demo mode on
# synthetic data with in-memory storage (the default Vercel first deploy).
# All values are validated at runtime by lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Public name shown in the UI (inlined into the browser bundle).
NEXT_PUBLIC_APP_NAME=Esocity
# Canonical site URL for metadata (OpenGraph, sitemap). Vercel URLs are used when unset.
NEXT_PUBLIC_APP_URL=

# Demo mode: shared "Demo Analyst" identity, synthetic data, no sign-in.
# Production mode (false) requires DATABASE_URL, AUTH_SECRET and an auth provider.
DEMO_MODE=true
# Pin the demo clock to a date (YYYY-MM-DD) for reproducible screenshots/tests.
DEMO_AS_OF=

LOG_LEVEL=info
RATE_LIMIT_ENABLED=true

# ── PostgreSQL (optional in demo mode) ───────────────────────────────────────
# Enables durable paper accounts, persisted backtests and the append-only audit trail.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# For the local docker-compose database see docs/ARCHITECTURE.md → Local development.
DATABASE_URL=
DATABASE_POOL_MAX=5

# ── Redis / Upstash (optional) ───────────────────────────────────────────────
# Shared cache and rate limits across serverless instances. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Python ML service (optional) ─────────────────────────────────────────────
# The app falls back to its TypeScript engines when unset or unreachable.
ML_API_URL=
# Shared secret (≥16 chars); must equal ML_API_KEY configured on the service.
ML_API_KEY=
ML_API_TIMEOUT_MS=2500

# ── Authentication (production mode) ─────────────────────────────────────────
# ≥32 random characters, e.g. `openssl rand -base64 32`. See docs/SECURITY.md.
AUTH_SECRET=

# ── Data providers ───────────────────────────────────────────────────────────
# Only "demo" is implemented in this release; others are documented placeholders.
# markets: demo | polygon | twelvedata | alphavantage | fmp | enterprise
MARKET_DATA_PROVIDER=demo
# sports: demo | sportmonks | api-football | opta
SPORTS_DATA_PROVIDER=demo
# Future provider keys (not read yet): POLYGON_API_KEY, TWELVE_DATA_API_KEY,
# ALPHA_VANTAGE_API_KEY, FMP_API_KEY, SPORTMONKS_API_TOKEN, API_FOOTBALL_KEY

# ── Broker ───────────────────────────────────────────────────────────────────
# Only "paper" is permitted. Live adapters are refused at runtime by design.
BROKER_ADAPTER=paper

# ── Build ────────────────────────────────────────────────────────────────────
# Set to "standalone" for container builds (the Dockerfile does this).
NEXT_OUTPUT=
